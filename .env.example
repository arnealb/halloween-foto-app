# Party Camera environment. Copy to `.env` (local) or set in Vercel.
# All of these are server-only: none may be prefixed with NEXT_PUBLIC_.

# Supabase project URL (Project Settings -> API).
SUPABASE_URL=https://your-project-ref.supabase.co
# Service-role / secret key (sb_secret_...). Server only, never in client code.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Database password and connection string (session pooler) for `npm run db:migrate`.
SUPABASE_DB_PASSWORD=your-db-password
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Host password for the admin.
ADMIN_PASSWORD=change-me
# Secret for signing the guest/admin cookies (at least 32 characters).
# Generate one with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string-of-32-plus-chars

# Public base URL the QR codes point to (production URL, not localhost).
PUBLIC_BASE_URL=https://your-party-camera.vercel.app
