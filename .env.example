# Party Camera: omgevingsvariabelen.
# Kopieer dit bestand naar `.env` (lokaal) en vul de echte waarden in, of zet
# ze in Vercel (Settings -> Environment Variables). Zet `.env` NOOIT in git.
# Alles hier is server-only: geef geen enkele variabele het voorvoegsel NEXT_PUBLIC_.

# --- Supabase (nodig voor de app, lokaal en op Vercel) ---------------------

# Project-URL van je Supabase-project (Project Settings -> Data API / API).
SUPABASE_URL=https://jouw-project-ref.supabase.co
# GEHEIM. Secret key (sb_secret_...) of de oude "service_role"-key
# (Project Settings -> API Keys). Geeft volledige toegang tot je database en
# foto's: alleen op de server, nooit delen of in client-code zetten.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Database-migratie (alleen nodig voor `npm run db:migrate`, niet op Vercel)

# GEHEIM. Optioneel: het databasewachtwoord, alleen om het bij de hand te
# hebben. De app en het migratiescript lezen deze variabele niet.
SUPABASE_DB_PASSWORD=jouw-database-wachtwoord
# GEHEIM. Verbindingsstring van de "Session pooler" (knop "Connect" bovenaan in
# Supabase). Speciale tekens in het wachtwoord moet je URL-encoderen (zie README).
SUPABASE_DB_URL=postgresql://postgres.jouw-project-ref:jouw-database-wachtwoord@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# --- Host / admin (nodig, lokaal en op Vercel) --------------------------------

# GEHEIM. Wachtwoord waarmee jij (de host) inlogt op /admin/login. Maak het lang.
ADMIN_PASSWORD=verander-mij
# GEHEIM. Sleutel waarmee de gast- en admin-cookies ondertekend worden (minstens
# 32 tekens). Maak er een met: openssl rand -base64 32
# Verander je hem later, dan is iedereen (gasten en admin) uitgelogd.
SESSION_SECRET=vervang-door-een-lange-willekeurige-tekst-van-32-plus-tekens

# --- Publieke URL (nodig op Vercel) --------------------------------------------

# Het adres waar de QR-codes naartoe wijzen: de productie-URL van je app,
# met https:// en zonder pad. Nooit localhost. De admin waarschuwt als het fout is.
PUBLIC_BASE_URL=https://jouw-party-camera.vercel.app
